load("@bazel_gazelle//:def.bzl", "gazelle")
load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

# Define the Gazelle target
gazelle(name = "gazelle")

go_library(
    name = "backend_lib",
    srcs = ["main.go"],
    importpath = "backend",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "backend",
    embed = [":backend_lib"],
    visibility = ["//visibility:public"],
)
